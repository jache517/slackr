# ---------------------------------------------------------------------------
# Required. Without these the app cannot reach Supabase and no page renders.
#
# Both are public by design: the publishable key is meant to sit in browser
# code, and row level security is what actually protects the data. They are
# read at build time as well as at runtime, so a deployment needs them set
# before it builds, not after.
#
# For local development, `npx supabase start` prints both:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from that output>
#
# `npx supabase db reset` then seeds the demo data. Sign in with the username
# owner and the password slackr-demo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Optional: connecting Google Docs and Meet.
#
# Needed together. Without them every other screen works and only the connect
# flow fails, with a configuration error. APP_URL must be the final origin
# with no path, and the callback registered in Google Cloud Console is
# APP_URL/api/integrations/google/callback.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional: AI-written report summaries.
#
# Left as `none`, the summary endpoint answers 503 with
# AI_PROVIDER_NOT_CONFIGURED and the report itself renders as normal. Set the
# provider to `openai` and supply a key to turn it on. The three tuning values
# below have defaults in code and only need setting to override them.
# ---------------------------------------------------------------------------
AI_REPORT_PROVIDER=none
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_TIMEOUT_MS=20000
# OPENAI_MAX_OUTPUT_TOKENS=2200

# ---------------------------------------------------------------------------
# Reserved. Nothing reads these yet, so setting them changes nothing.
#
# SUPABASE_SECRET_KEY bypasses row level security, so leave it unset until
# something genuinely needs it, and never put it anywhere browser code runs.
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
