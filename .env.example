# Application (server-only; use the final HTTPS origin when deployed)
APP_URL=http://localhost:3000

# Supabase (only NEXT_PUBLIC_* values may be read by browser code)
# For local development, `npx supabase start` prints these:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from that output>
#   SUPABASE_SECRET_KEY=<SECRET_KEY from that output>
# Then `npx supabase db reset` seeds owner@slackr.test; its sign-in link
# lands in Mailpit at http://127.0.0.1:54324.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub OAuth (post-MVP placeholders; unused by the public-only MVP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (server-only; callback is APP_URL/api/integrations/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI report generation (server-only; never expose OPENAI_API_KEY to browser code)
AI_REPORT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=2200
